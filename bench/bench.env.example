# Copy to bench/bench.env and fill in. bench.env is git-ignored.

# Host the nodes pull bench images from. It must resolve from the nodes and be
# served over HTTPS with a certificate containerd and Angry Duck trust. On
# sahand-k8s-stg the HAProxy in front only passes known hosts, so the bench
# shares the API host and takes only /v2/bench/ on it.
BENCH_HOST=api-stg.sahand-k8s.snappfood.dev
BENCH_INGRESS_PATH=/v2/bench/

# TLS secret for BENCH_HOST, inside BENCH_NS. Empty: no tls section on the
# bench ingress (TLS ends at HAProxy on stg).
TLS_SECRET=

INGRESS_CLASS=ingress-nginx
KUBECTL="sudo kubectl --context stg"

# Images the bench itself runs. The nodes pull the first two; the toolbox pod
# fetches BASE_IMAGE itself with crane, so it must be reachable from pods.
REGISTRY_IMAGE=docker.io/library/registry:2
TOOLBOX_IMAGE=gcr.io/go-containerregistry/crane:debug
BASE_IMAGE=docker.io/library/busybox:1.36

# <namespace>/<secret> holding Nexus credentials, if it needs any. Copied into
# the bench namespace for the pods above and for the toolbox's base pulls.
PULL_SECRET_FROM=

# SSH to the nodes (preflight checks and the disk-pressure fill).
SSH_USER=root

# Seconds between the webhook and the rollout in the preheat scenario: the
# rest of your pipeline after docker push.
PREHEAT_LEAD=60

# Single-node scenarios (outage-one-holder, outage-rescue, disk-pressure).
# Empty: the least full untainted node.
NODE=

# disk-pressure: fill target (max 0.82) and how long to hold it.
FILL_TARGET=0.75
FILL_HOLD=300
