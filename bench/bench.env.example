# Copy to bench/bench.env and fill in. bench.env is git-ignored.

# Host the nodes pull bench images from. It must resolve from the nodes and be
# served over HTTPS with a certificate containerd and Angry Duck trust. If a
# load balancer in front only passes known hosts, share a host it passes and
# take only /v2/bench/ on it.
BENCH_HOST=registry-bench.example.com
BENCH_INGRESS_PATH=/
# BENCH_INGRESS_PATH=/v2/bench/

# TLS secret for BENCH_HOST, inside BENCH_NS. Empty: no tls section on the
# bench ingress (TLS ends in front of the ingress).
TLS_SECRET=

INGRESS_CLASS=nginx
KUBECTL="kubectl --context my-test-cluster"

# Images the bench itself runs. The nodes pull the first two; the toolbox pod
# fetches BASE_IMAGE itself with crane, so it must be reachable from pods.
REGISTRY_IMAGE=docker.io/library/registry:2
TOOLBOX_IMAGE=gcr.io/go-containerregistry/crane:debug
BASE_IMAGE=docker.io/library/busybox:1.36

# Pull the three images through your own proxy registry if nodes can't reach
# Docker Hub or gcr.io (e.g. my-proxy.example.com/docker-hub/registry:2).

# <namespace>/<secret> holding credentials for that proxy, if it needs any.
# Copied into the bench namespace for the pods above and the toolbox's pulls.
PULL_SECRET_FROM=

# SSH to the nodes (preflight checks and the disk-pressure fill).
SSH_USER=root

# Seconds between the webhook and the rollout in the preheat scenario: the
# rest of your pipeline after docker push.
PREHEAT_LEAD=60

# Single-node scenarios (outage-one-holder, outage-rescue, disk-pressure).
# Empty: the least full untainted node.
NODE=

# disk-pressure: fill target (max 0.82) and how long to hold it.
FILL_TARGET=0.75
FILL_HOLD=300

# Resources: seconds between samples, and how long to keep sampling after a
# run (memory that isn't given back). RES_AFTER=0 skips it.
RES_INTERVAL=15
RES_AFTER=300

# files size: one layer of FILES_COUNT files of FILE_KB each.
FILES_COUNT=20000
FILE_KB=8

# on | off: unpacking while blobs arrive for the runs (on needs Helm's
# worker.streamUnpack.enabled). Empty: as deployed.
STREAM_UNPACK=

# Sample containerd's own cgroup on every node over SSH (cgroup v2): 1 or 0.
RES_CONTAINERD=1
