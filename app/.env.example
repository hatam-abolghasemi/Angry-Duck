LOG_LEVEL=info
METRICS_LABEL_REGISTRY=false
RESCUE_TOKEN_PATH=/etc/angryduck/rescue-token/token
AUTH_MODE=enforce
WEBHOOK_TOKEN_PATH=/etc/angryduck/webhook-token/token
REGISTRY_CREDENTIALS_PATH=

CONTROLLER_LISTEN_ADDR=:8080
WORKER_STALE_AFTER_S=30

RANK_TOP_N=5
RANK_INTERVAL_S=10
TARGET_TTL_S=120
RANK_BY_LAYERS=true
RANK_PLATFORM=linux/amd64
RANK_RESOLVE_TIMEOUT_S=5
RANK_RESOLVE_CACHE_S=600
RANK_PREFER_IMAGE_LOCALITY=true
RANK_EXCLUDE_NODE_SUBSTRINGS=

SPREAD_ENABLED=true
SPREAD_MAX_REGISTRY_PULLS=
SPREAD_RACE_PER_BLOB=2
SPREAD_RETRY_AFTER_S=15
SPREAD_BACKOFF_MAX_S=600
SPREAD_TRANSFER_TIMEOUT_S=1800

PROPAGATE_ENABLED=true
PROPAGATE_INTERVAL_S=10
PROPAGATE_WINDOW_S=0
PROPAGATE_MAX_CONCURRENT=8
PROPAGATE_PER_SOURCE=1
PROPAGATE_MAX_UTILIZATION=0.70
PROPAGATE_SEED_TIMEOUT_MIN_S=120
PROPAGATE_SEED_TIMEOUT_MAX_S=600
PROPAGATE_SEED_TIMEOUT_FACTOR=3
PROPAGATE_EXCLUDE_NODE_SUBSTRINGS=

RESCUE_ENABLED=true
RESCUE_INTERVAL_S=15
RESCUE_RESYNC_INTERVAL_S=600
RESCUE_RETRY_AFTER_S=120
RESCUE_BACKOFF_MAX_S=3600
RESCUE_TIMEOUT_S=600
RESCUE_MAX_CONCURRENT=2
RESCUE_MAX_SOURCES=3
RESCUE_NODE_MAX_CONCURRENT=2
RESCUE_PIN_TTL_S=3600
RESCUE_STATE_DIR=/var/lib/angryduck
RESCUE_CONTAINERD_NAMESPACE=k8s.io
RESCUE_PLATFORM=

NODE_ID=
SELF_ADDRESS=
WORKER_LISTEN_ADDR=:18081
CONTROLLER_URL=http://angryduck-controller:8080
REPORT_INTERVAL_S=15
NODE_EXPORTER_URL=http://localhost:9100/metrics
DAEMONSET_NAME=angryduck-worker
CONTAINER_RUNTIME=containerd
CONTAINER_RUNTIME_ENDPOINT=unix:///run/containerd/containerd.sock
CONTAINERD_SNAPSHOTTER=overlayfs
CONTAINERD_ROOT=
HOST_ROOT=
LAYER_INVENTORY_ENABLED=true
LAYER_SCAN_INTERVAL_S=60
INVENTORY_EVENTS_ENABLED=true
LAYER_RESYNC_INTERVAL_S=600
PREHEAT_ATTRIBUTION_INTERVAL_S=300
PREHEAT_ATTRIBUTION_RETENTION_S=360

MIRROR_ENABLED=false
MIRROR_LISTEN_ADDR=:18082
MIRROR_ADVERTISE_ADDR=
MIRROR_CONTAINERD_CONFIG_DIR=/etc/containerd/certs.d
MIRROR_REGISTRIES=

GC_ENABLED=true
GC_INTERVAL_S=60
GC_UNUSED_FOR_S=21600
GC_HIGH_UTILIZATION=0.70
GC_LOW_UTILIZATION=0.60
GC_ROLLBACK_KEEP=3
GC_BATCH=5
GC_SETTLE_S=10
GC_PROTECT_SUBSTRINGS=pause
