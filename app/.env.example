# Angry Duck configuration
# Copy this to .env (or mount as a ConfigMap/env in k8s) and adjust.
# All interval/threshold values are plain integers; time-based ones are
# always in seconds.

# Log verbosity for both the controller and worker: debug, info, warn, or
# error. debug shows every per-image decision GC makes on every check and
# the raw disk-utilization math the reporter computes; info (the default)
# shows normal operational events without that volume; warn/error show only
# consequential decisions and failures. Unrecognized values fall back to
# info rather than erroring.
LOG_LEVEL=info

# Shared by both the controller and the worker (both read this file /
# ConfigMap). When true, angryduck_worker_images_deleted_total,
# angryduck_worker_images_deleted_byte_size_total,
# angryduck_worker_pulls_total, and angryduck_controller_pull_orders_total
# all gain a "registry" label (the image's registry host — "docker.io" for
# unqualified references, since that's what Docker itself assumes). Off by
# default: unlike "node", registry host isn't a bounded set — a cluster
# that pulls from many registries over time can accumulate a lot of label
# combinations, multiplied by node. Turn on for troubleshooting which
# registries' images are filling disk; turn back off if your Prometheus
# setup complains about series count.
METRICS_LABEL_REGISTRY=false

# When set, angryduck_worker_pull_duration_seconds gains a "spegel" label
# ("true"/"false"/"unknown") reporting whether a container whose image
# reference contains this substring was running on the node at pull time —
# a way to tell whether a given preheat pull's timing was measured with
# Spegel in place, using only the local container runtime (no Kubernetes
# API call, no extra RBAC). Empty (the default) disables this entirely —
# no extra runtime call is made unless set, and even when set it only
# costs one extra call per PULL (a low-frequency event, not a timer), so
# it stays cheap regardless of CONTAINER_RUNTIME. A typical value is
# "spegel", matching Spegel's own image name — adjust if your registry
# mirror renames it.
SPEGEL_IMAGE_SUBSTRING=

# How often (seconds) to clear angryduck_worker_pull_duration_seconds so a
# pull's duration is visible for roughly one scrape instead of lingering
# as a stale "last known value" until the next pull happens (which could
# be minutes or hours later). Match this to your actual Prometheus
# scrape_interval — Angry Duck cannot observe that value itself, so this
# is only an approximation of scrape timing, not a guarantee every value
# is scraped before being cleared. 0 disables resetting (the gauge then
# holds its last value indefinitely, the old behavior).
PULL_DURATION_RESET_INTERVAL_S=15

# ---------------------------------------------------------------------------
# Controller
# ---------------------------------------------------------------------------

# Address the controller HTTP server listens on.
CONTROLLER_LISTEN_ADDR=:8080

# A worker not heard from in this many seconds is considered stale / opted
# out and excluded from ranking until it reports again.
WORKER_STALE_AFTER_S=30

# How long a preheat target image stays "active" (being re-ordered on every
# ranking tick) after the webhook sets it, in seconds.
TARGET_TTL_S=120

# How often (seconds) the controller re-ranks fresh workers and re-orders
# the lowest-N to pull the current target image.
RANK_INTERVAL_S=10

# How many workers get ordered to pull per preheat.
RANK_TOP_N=2

# When true (the default), a node that already has some OLDER tag of the
# same repo present locally is preferred over a node that doesn't have the
# repo at all, even if the other node is emptier — pulling a new tag onto
# a node that already has the repo is usually a much smaller delta, since
# most layers (base image, dependencies) are typically unchanged between
# tags of the same repo. Within each of those two groups, nodes are still
# ranked by lowest utilization first, same as before. The match is by bare
# repo identity only (registry host + path, tag/digest stripped) — no
# registry manifest calls are made to check actual layer overlap, since
# preheat is racing ArgoCD's sync loop and can't afford the round trip.
# Set to false to restore plain utilization-only ranking.
RANK_PREFER_IMAGE_LOCALITY=true

# Comma-separated substrings matched against a worker's NodeID (its k8s
# node name, via the downward API). Any worker whose NodeID contains one
# of these is still tracked as fresh and still runs its own GC loop as
# normal — it is simply never selected as a preheat target. Intended for
# master/control-plane nodes: they still need Angry Duck's worker for disk
# GC, but real workload pods are never scheduled onto them (they don't
# carry the taint tolerations to land there), so a master's disk
# utilization is structurally lower and it would otherwise keep winning
# the ranking despite no pod ever actually pulling the benefit. Leave
# empty (the default) to disable and consider every fresh worker.
RANK_EXCLUDE_NODE_SUBSTRINGS=

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

# Unique node identifier. Defaults to the pod/host hostname if unset — set
# this explicitly via the k8s downward API (spec.nodeName) in production.
NODE_ID=

# host:port at which the controller can reach this worker's HTTP API.
# Typically the pod IP (downward API status.podIP) plus WORKER_LISTEN_ADDR's
# port. Required — the worker refuses to start without it.
SELF_ADDRESS=

# Address the worker's own HTTP server (receiving /pull orders) listens on.
# Picked an uncommon port deliberately — 8081 collided with nginx already
# running on our nodes.
WORKER_LISTEN_ADDR=:18081

# node-exporter metrics endpoint this worker scrapes for disk utilization.
NODE_EXPORTER_URL=http://localhost:9100/metrics

# Base URL of the controller (no trailing slash), e.g. the in-cluster
# Service DNS name.
CONTROLLER_URL=http://angryduck-controller:8080

# How often (seconds) this worker pushes a report of its disk utilization
# and local image inventory (repo names, tag/digest stripped) to the
# controller. Building that inventory is one extra LocalImages() call to
# the container runtime per tick (see CONTAINER_RUNTIME below) — cheap on
# every supported backend, but independent from GC's own use of the same
# call on GC_CHECK_INTERVAL_S.
REPORT_INTERVAL_S=15

# How often (seconds) PreheatMonitor samples currently-running containers
# against repos this worker has recently preheated, to answer "is preheat
# actually helping" (angryduck_worker_preheated_containers_running).
# Deliberately much coarser than GC_CHECK_INTERVAL_S: this is a periodic
# sample for a dashboard question, not something a rollout needs to react
# to. Already cheap by default — the monitor skips its runtime call
# entirely on any node with nothing preheated recently, which in practice
# is most nodes in a fleet (only RANK_TOP_N nodes are ever preheat seeds
# at a time). On CONTAINER_RUNTIME=containerd specifically this is a
# second N+1-subprocess pass on top of GC's own when it DOES run; set to
# 0 to disable the monitor entirely.
PREHEAT_ATTRIBUTION_INTERVAL_S=300

# How long (seconds) after a successful preheat pull its repo still counts
# as "preheated" for the sample above. Set this to roughly
# GC_GRACE_PERIOD_S + (GC_MISS_THRESHOLD * GC_CHECK_INTERVAL_S) for the GC
# settings below — that sum is the worst-case time an UNTOUCHED preheated
# image survives on disk before GC reclaims it (protected during the grace
# period, then up to GC_MISS_THRESHOLD checks at GC_CHECK_INTERVAL_S).
# Past that point, if nothing used the image, it's already gone — so
# still calling the repo "preheated" would be stale. The default here
# (360) matches the GC defaults below (60 + 5*60); recompute it if you
# change those.
PREHEAT_ATTRIBUTION_RETENTION_S=360

# How often (seconds) the GC loop checks for unused local images.
GC_CHECK_INTERVAL_S=60

# Number of consecutive GC checks an image must be unused for before it's
# removed.
GC_MISS_THRESHOLD=5

# Grace period (seconds) after a controller-ordered pull during which the
# image is protected from GC even if nothing is using it yet — covers the
# window between the pre-pull and Argo actually scheduling a pod that needs
# the image.
GC_GRACE_PERIOD_S=60

# When true (the default), GC logs exactly what it would remove and why, but
# never actually calls RemoveImage. Angry Duck's GC scans and can remove ANY
# image on the node, not just ones it pulled itself — set this to false only
# after watching a dry-run pass log sensible decisions against your real
# workloads, ideally right after any change to the matching logic in
# internal/worker/runtime.go.
GC_DRY_RUN=true

# Comma-separated substrings matched against each local image reference.
# Any match is spared unconditionally and permanently — GC never even
# checks whether it's running, and its miss counter never advances. This
# is deliberately separate from (and stronger than) the running-container
# check: the pause image backs every pod sandbox on the node, but
# containerd/CRI tracks sandboxes separately from regular containers, so
# `crictl ps` never reports it and GC can never observe it as "running" no
# matter how correct the digest-matching logic is. node-exporter is the
# other common case if it runs as a static pod or outside the normal
# container lifecycle Angry Duck observes. Leave empty (the default) to
# exclude nothing, which was the only behavior before this existed.
GC_EXCLUDE_IMAGE_SUBSTRINGS=

# Which CLI to shell out to for image operations: crictl (default),
# containerd (ctr), or docker. None of them ship in the worker image: the
# worker runs the node's own binary (see HOST_ROOT below), found in
# /usr/local/sbin, /usr/local/bin, /usr/sbin, /usr/bin, /sbin, /bin — in
# that order, so a Kubespray install in /usr/local/bin wins over an apt one
# in /usr/bin, same as a shell. The worker exits at startup if the node
# doesn't have the binary this setting needs.
#
# crictl is the recommended default: it lists every running container's
# image in one `crictl ps -o json` call. The containerd backend has no
# equivalent bulk call — ListRunningImages() lists container IDs, then
# shells out to `ctr containers info <id>` once PER container, every GC
# tick. On a node with 100+ containers that's 100+ subprocess spawns a
# minute, which is enough on its own to push a low-CPU-limit worker pod
# 2-3x over its own limit. Only use containerd if crictl genuinely isn't
# available on your nodes.
CONTAINER_RUNTIME=crictl

# The node's containerd socket, as a NODE path (it's resolved inside the
# node's root, not the container's). Passed to crictl as `-r` and to ctr as
# `-a` for peer transfers. No hostPath mount is needed for it.
CONTAINER_RUNTIME_ENDPOINT=unix:///run/containerd/containerd.sock

# Where the node's root filesystem is visible from inside the worker
# container. Every crictl/ctr/docker call is chrooted here, so it runs the
# node's binary with the node's libc and the node's /etc/crictl.yaml.
#
# /proc/1/root (default) is the node's real root, live mounts included,
# and needs no volume — only hostPID: true and privileged, which the
# DaemonSet already has (it is the same permission `nsenter -t 1` needs).
# If a hardened node ever blocks it, mount hostPath "/" at /host with
# mountPropagation: HostToContainer and set HOST_ROOT=/host instead.
# Set to "/" for local runs outside Kubernetes (plain PATH lookup, no
# chroot).
HOST_ROOT=/proc/1/root

# Path to a dockerconfigjson file (the same format `docker login` writes
# and Kubernetes imagePullSecrets use: {"auths": {"host": {"auth": "..."}}})
# for authenticating preheat pulls against private registries. The worker
# pulls by shelling out directly to the container runtime CLI, which
# bypasses kubelet's CRI plumbing entirely — kubelet's own
# imagePullSecrets never apply to these pulls, regardless of what's
# configured on any Pod. Leave empty to pull anonymously (only works for
# public images). One file can hold credentials for multiple registries —
# no need for one secret per registry.
REGISTRY_CREDENTIALS_PATH=

# ---------------------------------------------------------------------------
# Pod rescue (worker)
# ---------------------------------------------------------------------------
#
# GC only ever sees containerd/CRI state (crictl images, crictl ps). A pod
# stuck in Init:ImagePullBackOff never reaches that state at all — kubelet
# holds it before ever calling CreateContainer — so GC has no way to see it,
# no matter how correct its own logic is. This is most common when tag
# resolution against ORIGIN itself fails (network/DNS/auth issue for that
# specific registry from that specific node): the pull backs off before
# containerd ever asks anything else for help.
#
# Rescue closes that specific gap, and nothing more. It is NOT a general
# peer-to-peer mechanism (that's Spegel's job) and NOT a standing mirror in
# front of containerd:
#   - it only ever acts on a pod ALREADY stuck in ImagePullBackOff/ErrImagePull
#   - it asks the controller for AT MOST ONE node that already has the exact
#     image reference (not a digest lookup — the exact "repo:tag" string the
#     stuck pod's own status already reports)
#   - it makes exactly ONE attempt to copy the image from that one node
#   - on failure (no source, dial failed, transfer failed) it goes quiet for
#     RESCUE_RETRY_INTERVAL_S — there is no internal retry loop, no trying a
#     second or third source, no fan-out
#   - it needs the RBAC in deploy/*/rbac.yaml (get/list pods, cluster-wide,
#     since a stuck pod can be in any namespace)
#
# Because rescue only ever acts once kubelet has already told us the exact
# reference a specific pod is stuck on, it can serve that reference
# directly, by name — no manifest-digest resolution, no tag→digest
# tracking, no continuously-updated peer inventory the way a real mirror
# would need. The controller only tracks each node's exact local image
# list (a small, bounded set of strings), nothing more.

# Master switch. On by default: misconfiguration here fails soft (it logs
# why it's skipping and keeps counting/logging stuck pulls) rather than
# crashing the worker, since rescue is a narrow safety net, not core to
# what this worker does.
RESCUE_ENABLED=true

# How often (seconds) to poll this node's pods for stuck pulls.
RESCUE_POLL_INTERVAL_S=30

# How long (seconds) to wait before retrying a rescue that just failed.
# This IS the retry policy — there is no other backoff or retry loop, so
# this is the only thing standing between "tried once" and "tried again."
# Also throttles the WARN log line for a given stuck container: the first
# sighting logs at WARN, repeat sightings within this window log at DEBUG
# instead, so a long-stuck pod doesn't re-log the identical line every
# single poll, forever, on every node.
RESCUE_RETRY_INTERVAL_S=600

# At most this many /rescue-export requests run at once on one node.
# Rescue is a rare, occasional repair path, not a throughput mechanism —
# kept small deliberately (see README "Resource usage" for the memory
# this implies).
RESCUE_MAX_CONCURRENT_EXPORTS=1

# Shared secret a rescue import presents to the source node's
# /rescue-export. Optional, unlike the old mirror's equivalent — without
# it, rescue still runs and still counts/logs stuck pulls, it just can't
# fix anything, and that failure is loud (a log line), not silent. In k8s
# this comes from the angryduck-rescue Secret, not the ConfigMap.
RESCUE_PEER_TOKEN=

# Comma-separated substrings matched against a stuck pod's NAMESPACE.
# Any match is ignored entirely: no log, no metric, no rescue attempt. A
# fleet inevitably accumulates abandoned feature-branch deployments and
# deliberately-broken test/demo resources (chaos-engineering namespaces,
# policy-testing images) that have been stuck for a long time and were
# simply invisible before rescue existed — without this, rescue surfaces
# every one of them, forever, on every node that happens to schedule one.
# Leave empty (the default) to exclude nothing.
RESCUE_EXCLUDE_NAMESPACE_SUBSTRINGS=

# Comma-separated substrings matched against a stuck container's IMAGE
# reference. Same exclusion behavior as above, for cases identifiable by
# image rather than namespace (a deliberately-nonexistent tag used to
# test alerting, for example). Leave empty (the default) to exclude
# nothing.
RESCUE_EXCLUDE_IMAGE_SUBSTRINGS=
