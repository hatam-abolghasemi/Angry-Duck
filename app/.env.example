# Angry Duck configuration
# Copy this to .env (or mount as a ConfigMap/env in k8s) and adjust.
# All interval/threshold values are plain integers; time-based ones are
# always in seconds.

# Log verbosity for both the controller and worker: debug, info, warn, or
# error. debug shows every per-image decision GC makes on every check and
# the raw disk-utilization math the reporter computes; info (the default)
# shows normal operational events without that volume; warn/error show only
# consequential decisions and failures. Unrecognized values fall back to
# info rather than erroring.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Controller
# ---------------------------------------------------------------------------

# Address the controller HTTP server listens on.
CONTROLLER_LISTEN_ADDR=:8080

# A worker not heard from in this many seconds is considered stale / opted
# out and excluded from ranking until it reports again.
WORKER_STALE_AFTER_S=30

# How long a preheat target image stays "active" (being re-ordered on every
# ranking tick) after the webhook sets it, in seconds.
TARGET_TTL_S=120

# How often (seconds) the controller re-ranks fresh workers and re-orders
# the lowest-N to pull the current target image.
RANK_INTERVAL_S=10

# How many workers get ordered to pull per preheat.
RANK_TOP_N=2

# When true (the default), a node that already has some OLDER tag of the
# same repo present locally is preferred over a node that doesn't have the
# repo at all, even if the other node is emptier — pulling a new tag onto
# a node that already has the repo is usually a much smaller delta, since
# most layers (base image, dependencies) are typically unchanged between
# tags of the same repo. Within each of those two groups, nodes are still
# ranked by lowest utilization first, same as before. The match is by bare
# repo identity only (registry host + path, tag/digest stripped) — no
# registry manifest calls are made to check actual layer overlap, since
# preheat is racing ArgoCD's sync loop and can't afford the round trip.
# Set to false to restore plain utilization-only ranking.
RANK_PREFER_IMAGE_LOCALITY=true

# Comma-separated substrings matched against a worker's NodeID (its k8s
# node name, via the downward API). Any worker whose NodeID contains one
# of these is still tracked as fresh and still runs its own GC loop as
# normal — it is simply never selected as a preheat target. Intended for
# master/control-plane nodes: they still need Angry Duck's worker for disk
# GC, but real workload pods are never scheduled onto them (they don't
# carry the taint tolerations to land there), so a master's disk
# utilization is structurally lower and it would otherwise keep winning
# the ranking despite no pod ever actually pulling the benefit. Leave
# empty (the default) to disable and consider every fresh worker.
RANK_EXCLUDE_NODE_SUBSTRINGS=

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

# Unique node identifier. Defaults to the pod/host hostname if unset — set
# this explicitly via the k8s downward API (spec.nodeName) in production.
NODE_ID=

# host:port at which the controller can reach this worker's HTTP API.
# Typically the pod IP (downward API status.podIP) plus WORKER_LISTEN_ADDR's
# port. Required — the worker refuses to start without it.
SELF_ADDRESS=

# Address the worker's own HTTP server (receiving /pull orders) listens on.
# Picked an uncommon port deliberately — 8081 collided with nginx already
# running on our nodes.
WORKER_LISTEN_ADDR=:18081

# node-exporter metrics endpoint this worker scrapes for disk utilization.
NODE_EXPORTER_URL=http://localhost:9100/metrics

# Base URL of the controller (no trailing slash), e.g. the in-cluster
# Service DNS name.
CONTROLLER_URL=http://angryduck-controller:8080

# How often (seconds) this worker pushes a report of its disk utilization
# and local image inventory (repo names, tag/digest stripped) to the
# controller. Building that inventory is one extra LocalImages() call to
# the container runtime per tick (see CONTAINER_RUNTIME below) — cheap on
# every supported backend, but independent from GC's own use of the same
# call on GC_CHECK_INTERVAL_S.
REPORT_INTERVAL_S=15

# How often (seconds) the GC loop checks for unused local images.
GC_CHECK_INTERVAL_S=60

# Number of consecutive GC checks an image must be unused for before it's
# removed.
GC_MISS_THRESHOLD=5

# Grace period (seconds) after a controller-ordered pull during which the
# image is protected from GC even if nothing is using it yet — covers the
# window between the pre-pull and Argo actually scheduling a pod that needs
# the image.
GC_GRACE_PERIOD_S=60

# When true (the default), GC logs exactly what it would remove and why, but
# never actually calls RemoveImage. Angry Duck's GC scans and can remove ANY
# image on the node, not just ones it pulled itself — set this to false only
# after watching a dry-run pass log sensible decisions against your real
# workloads, ideally right after any change to the matching logic in
# internal/worker/runtime.go.
GC_DRY_RUN=true

# Comma-separated substrings matched against each local image reference.
# Any match is spared unconditionally and permanently — GC never even
# checks whether it's running, and its miss counter never advances. This
# is deliberately separate from (and stronger than) the running-container
# check: the pause image backs every pod sandbox on the node, but
# containerd/CRI tracks sandboxes separately from regular containers, so
# `crictl ps` never reports it and GC can never observe it as "running" no
# matter how correct the digest-matching logic is. node-exporter is the
# other common case if it runs as a static pod or outside the normal
# container lifecycle Angry Duck observes. Leave empty (the default) to
# exclude nothing, which was the only behavior before this existed.
GC_EXCLUDE_IMAGE_SUBSTRINGS=

# Which CLI to shell out to for image operations: crictl (default),
# containerd (ctr), or docker.
#
# crictl is the recommended default: it lists every running container's
# image in one `crictl ps -o json` call. The containerd backend has no
# equivalent bulk call — ListRunningImages() lists container IDs, then
# shells out to `ctr containers info <id>` once PER container, every GC
# tick. On a node with 100+ containers that's 100+ subprocess spawns a
# minute, which is enough on its own to push a low-CPU-limit worker pod
# 2-3x over its own limit. Only use containerd if crictl genuinely isn't
# available on your nodes.
CONTAINER_RUNTIME=crictl

# CRI runtime socket, only consulted by the crictl backend (`crictl -r
# <endpoint> ...`). Defaults to the path every deploy manifest already
# mounts, so you normally won't need to change this — it exists mainly so
# local/non-k8s runs can point crictl at wherever their socket actually is.
CONTAINER_RUNTIME_ENDPOINT=unix:///run/containerd/containerd.sock

# Path to a dockerconfigjson file (the same format `docker login` writes
# and Kubernetes imagePullSecrets use: {"auths": {"host": {"auth": "..."}}})
# for authenticating preheat pulls against private registries. The worker
# pulls by shelling out directly to the container runtime CLI, which
# bypasses kubelet's CRI plumbing entirely — kubelet's own
# imagePullSecrets never apply to these pulls, regardless of what's
# configured on any Pod. Leave empty to pull anonymously (only works for
# public images). One file can hold credentials for multiple registries —
# no need for one secret per registry.
REGISTRY_CREDENTIALS_PATH=
