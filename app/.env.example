# Angry Duck configuration
#
# Copy to .env for local runs, or put these in the ConfigMap in Kubernetes.
# Real environment variables override the file. Durations are integers in
# seconds; utilizations are fractions between 0 and 1.
# Reference: docs/configuration.md

# ---------------------------------------------------------------------------
# General (controller and worker)
# ---------------------------------------------------------------------------

# debug, info, warn or error. Unknown values fall back to info.
LOG_LEVEL=info

# Add a "registry" label (the image's registry host) to the pull metrics.
# Off by default because the set of registries is unbounded.
METRICS_LABEL_REGISTRY=false

# Shared bearer token file, at least 32 characters, mounted in the
# controller and every worker. Rescue, propagation and the mirror stay off
# without it. Read once at startup: restart everything after rotating it.
RESCUE_TOKEN_PATH=/etc/angryduck/rescue-token/token

# dockerconfigjson with credentials for every private registry. The worker
# uses it for seed pulls (kubelet's imagePullSecrets don't apply to them);
# the controller uses it to read manifests when ranking by layers.
REGISTRY_CREDENTIALS_PATH=

# ---------------------------------------------------------------------------
# Controller
# ---------------------------------------------------------------------------

CONTROLLER_LISTEN_ADDR=:8080

# A worker silent for this long is ignored until it reports again.
WORKER_STALE_AFTER_S=30

# ---------------------------------------------------------------------------
# Preheat: choosing seed nodes (controller)
# ---------------------------------------------------------------------------

# Nodes ordered to pull each pushed image from the registry.
RANK_TOP_N=5

# How often pull orders are (re)issued, and for how long after the webhook.
RANK_INTERVAL_S=10
TARGET_TTL_S=120

# Rank by bytes each node already holds, reading the image's manifest and
# config (a few KB) from its registry. Falls back to repo locality, then
# disk utilization, when the manifest can't be read.
RANK_BY_LAYERS=true
RANK_PLATFORM=linux/amd64
RANK_RESOLVE_TIMEOUT_S=5
RANK_RESOLVE_CACHE_S=600

# Fallback ranking: prefer nodes holding any tag of the same repo.
RANK_PREFER_IMAGE_LOCALITY=true

# Comma-separated node name substrings never chosen as seeds,
# e.g. master,control-plane.
RANK_EXCLUDE_NODE_SUBSTRINGS=

# ---------------------------------------------------------------------------
# Propagation (controller)
# ---------------------------------------------------------------------------

# Spread each pushed image from the seeds to every eligible node.
PROPAGATE_ENABLED=true
PROPAGATE_INTERVAL_S=10

# How long to keep spreading a push. 0 means until every eligible node has
# it or a newer tag of the same repo supersedes it.
PROPAGATE_WINDOW_S=0

# Concurrent transfers cluster-wide, and sends per source node.
PROPAGATE_MAX_CONCURRENT=8
PROPAGATE_PER_SOURCE=1

# Nodes fuller than this wait until image cleanup frees space. Keep it at
# or below GC_HIGH_UTILIZATION.
PROPAGATE_MAX_UTILIZATION=0.70

# A seed still pulling after max(MIN, FACTOR x the first seed's pull time),
# or MAX while no seed has finished, is cancelled and served by peers.
PROPAGATE_SEED_TIMEOUT_MIN_S=120
PROPAGATE_SEED_TIMEOUT_MAX_S=600
PROPAGATE_SEED_TIMEOUT_FACTOR=3

# Node name substrings to skip. Defaults to RANK_EXCLUDE_NODE_SUBSTRINGS.
# Rescue still covers these nodes.
# PROPAGATE_EXCLUDE_NODE_SUBSTRINGS=master,control-plane

# ---------------------------------------------------------------------------
# Rescue of pods stuck in ImagePullBackOff
# ---------------------------------------------------------------------------

RESCUE_ENABLED=true

# Controller: how often Pending pods are listed.
RESCUE_INTERVAL_S=15

# Controller: wait before retrying a node and image. Doubles after each
# failure in a row, up to RESCUE_BACKOFF_MAX_S.
RESCUE_RETRY_AFTER_S=120
RESCUE_BACKOFF_MAX_S=3600

# Controller: how long to wait for one rescue (the worker keeps going).
RESCUE_TIMEOUT_S=600

# Controller: rescues in flight cluster-wide, and sources offered per rescue.
RESCUE_MAX_CONCURRENT=2
RESCUE_MAX_SOURCES=3

# Worker: images received at the same time.
RESCUE_NODE_MAX_CONCURRENT=2

# Worker: snapshots from a failed attempt stay pinned this long so a retry
# doesn't ship them again.
RESCUE_PIN_TTL_S=3600

# Worker: node directory for pins and image usage times.
RESCUE_STATE_DIR=/var/lib/angryduck

# Worker: containerd namespace holding kubelet's images.
RESCUE_CONTAINERD_NAMESPACE=k8s.io

# Worker: platform to import. Defaults to linux/<the worker's architecture>.
# RESCUE_PLATFORM=linux/amd64

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

# Node name (downward API spec.nodeName) and the address the controller and
# peers reach this worker at (status.podIP). SELF_ADDRESS is required.
NODE_ID=
SELF_ADDRESS=
WORKER_LISTEN_ADDR=:18081

CONTROLLER_URL=http://angryduck-controller:8080
REPORT_INTERVAL_S=15

# node-exporter endpoint used to read root filesystem utilization.
NODE_EXPORTER_URL=http://localhost:9100/metrics

# crictl (recommended), containerd (ctr) or docker. The worker runs the
# node's own binary. With containerd, listing running containers costs one
# subprocess per container, which is expensive on busy nodes.
CONTAINER_RUNTIME=crictl

# containerd socket, as a path on the node.
CONTAINER_RUNTIME_ENDPOINT=unix:///run/containerd/containerd.sock

# containerd's root directory on the node. The worker serves blobs by
# reading its content store directly instead of running a ctr process per
# blob. Empty: the top-level root in the node's /etc/containerd/config.toml,
# else /var/lib/containerd. If the store isn't found, blobs go through ctr.
CONTAINERD_ROOT=

# Where the node's root filesystem is visible. Runtime commands are chrooted
# here. /proc/1/root needs hostPID, SYS_CHROOT, SYS_PTRACE and an unconfined
# AppArmor profile. Use / for local runs outside Kubernetes.
HOST_ROOT=/proc/1/root

# Report each node's layer blobs and snapshot chainIDs to the controller, as
# deltas. Used to rank seeds, pick sources and answer mirror lookups.
LAYER_INVENTORY_ENABLED=true
LAYER_SCAN_INTERVAL_S=60

# Sample running containers from recently preheated repos
# (angryduck_worker_preheated_containers_running). 0 disables it.
PREHEAT_ATTRIBUTION_INTERVAL_S=300
PREHEAT_ATTRIBUTION_RETENTION_S=360

# ---------------------------------------------------------------------------
# Mirror (worker)
# ---------------------------------------------------------------------------

# Pull-only registry mirror for the node's containerd, answering from the
# node or a peer. containerd's CRI registry config_path must point at
# MIRROR_CONTAINERD_CONFIG_DIR.
MIRROR_ENABLED=false
MIRROR_LISTEN_ADDR=127.0.0.1:18082
MIRROR_CONTAINERD_CONFIG_DIR=/etc/containerd/certs.d

# Registries to mirror even before the node holds an image from them.
MIRROR_REGISTRIES=

# ---------------------------------------------------------------------------
# Image cleanup (worker)
# ---------------------------------------------------------------------------

# An image not running on the node is removed when it has been unused for
# GC_UNUSED_FOR_S, or when the disk is above GC_HIGH_UTILIZATION (then
# oldest first, down to GC_LOW_UTILIZATION). The newest GC_ROLLBACK_KEEP
# unused images per repo go last, only while the disk is above high.
GC_ENABLED=true
GC_INTERVAL_S=60
GC_UNUSED_FOR_S=21600
GC_HIGH_UTILIZATION=0.70
GC_LOW_UTILIZATION=0.60
GC_ROLLBACK_KEEP=3

# Images removed per batch, and the wait before re-measuring the disk.
GC_BATCH=5
GC_SETTLE_S=10

# Never remove images whose name contains one of these.
GC_PROTECT_SUBSTRINGS=pause
