# Angry Duck configuration
# Copy this to .env (or mount as a ConfigMap/env in k8s) and adjust.
# All interval/threshold values are plain integers; time-based ones are
# always in seconds.

# Log verbosity for both the controller and worker: debug, info, warn, or
# error. debug shows every per-image decision the reporter makes when
# building its locality inventory and the raw disk-utilization math it
# computes; info (the default) shows normal operational events without
# that volume; warn/error show only consequential decisions and failures.
# Unrecognized values fall back to info rather than erroring.
LOG_LEVEL=info

# Shared by both the controller and the worker (both read this file /
# ConfigMap). When true, angryduck_worker_pulls_total,
# angryduck_worker_pull_duration_seconds and
# angryduck_controller_pull_orders_total all gain a "registry" label (the image's registry host — "docker.io" for
# unqualified references, since that's what Docker itself assumes). Off by
# default: unlike "node", registry host isn't a bounded set — a cluster
# that pulls from many registries over time can accumulate a lot of label
# combinations, multiplied by node. Turn on for troubleshooting pulls
# per registry; turn back off if your Prometheus
# setup complains about series count.
METRICS_LABEL_REGISTRY=false

# When set, angryduck_worker_pull_duration_seconds gains a "spegel" label
# ("true"/"false"/"unknown") reporting whether a container whose image
# reference contains this substring was running on the node at pull time —
# a way to tell whether a given preheat pull's timing was measured with
# Spegel in place, using only the local container runtime (no Kubernetes
# API call, no extra RBAC). Empty (the default) disables this entirely —
# no extra runtime call is made unless set, and even when set it only
# costs one extra call per PULL (a low-frequency event, not a timer), so
# it stays cheap regardless of CONTAINER_RUNTIME. A typical value is
# "spegel", matching Spegel's own image name — adjust if your registry
# mirror renames it.
SPEGEL_IMAGE_SUBSTRING=

# How often (seconds) to clear angryduck_worker_pull_duration_seconds so a
# pull's duration is visible for roughly one scrape instead of lingering
# as a stale "last known value" until the next pull happens (which could
# be minutes or hours later). Match this to your actual Prometheus
# scrape_interval — Angry Duck cannot observe that value itself, so this
# is only an approximation of scrape timing, not a guarantee every value
# is scraped before being cleared. 0 disables resetting (the gauge then
# holds its last value indefinitely, the old behavior).
PULL_DURATION_RESET_INTERVAL_S=15

# ---------------------------------------------------------------------------
# Controller
# ---------------------------------------------------------------------------

# Address the controller HTTP server listens on.
CONTROLLER_LISTEN_ADDR=:8080

# A worker not heard from in this many seconds is considered stale / opted
# out and excluded from ranking until it reports again.
WORKER_STALE_AFTER_S=30

# How long a preheat target image stays "active" (being re-ordered on every
# ranking tick) after the webhook sets it, in seconds.
TARGET_TTL_S=120

# How often (seconds) the controller re-ranks fresh workers and re-orders
# the lowest-N to pull the current target image.
RANK_INTERVAL_S=10

# How many workers get ordered to pull per preheat.
RANK_TOP_N=2

# When true (the default), a node that already has some OLDER tag of the
# same repo present locally is preferred over a node that doesn't have the
# repo at all, even if the other node is emptier — pulling a new tag onto
# a node that already has the repo is usually a much smaller delta, since
# most layers (base image, dependencies) are typically unchanged between
# tags of the same repo. Within each of those two groups, nodes are still
# ranked by lowest utilization first, same as before. The match is by bare
# repo identity only (registry host + path, tag/digest stripped) — no
# registry manifest calls are made to check actual layer overlap, since
# preheat is racing ArgoCD's sync loop and can't afford the round trip.
# Set to false to restore plain utilization-only ranking.
RANK_PREFER_IMAGE_LOCALITY=true

# Comma-separated substrings matched against a worker's NodeID (its k8s
# node name, via the downward API). Any worker whose NodeID contains one
# of these is still tracked as fresh and still reports disk utilization as
# normal — it is simply never selected as a preheat target. Intended for
# master/control-plane nodes: real workload pods are never scheduled onto
# them (they don't carry the taint tolerations to land there), so a
# master's disk utilization is structurally lower and it would otherwise
# keep winning the ranking despite no pod ever actually pulling the
# benefit. Leave empty (the default) to disable and consider every fresh
# worker.
RANK_EXCLUDE_NODE_SUBSTRINGS=

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------

# Unique node identifier. Defaults to the pod/host hostname if unset — set
# this explicitly via the k8s downward API (spec.nodeName) in production.
NODE_ID=

# host:port at which the controller can reach this worker's HTTP API.
# Typically the pod IP (downward API status.podIP) plus WORKER_LISTEN_ADDR's
# port. Required — the worker refuses to start without it.
SELF_ADDRESS=

# Address the worker's own HTTP server (receiving /pull orders) listens on.
# Picked an uncommon port deliberately — 8081 collided with nginx already
# running on our nodes.
WORKER_LISTEN_ADDR=:18081

# node-exporter metrics endpoint this worker scrapes for disk utilization.
NODE_EXPORTER_URL=http://localhost:9100/metrics

# Base URL of the controller (no trailing slash), e.g. the in-cluster
# Service DNS name.
CONTROLLER_URL=http://angryduck-controller:8080

# How often (seconds) this worker pushes a report of its disk utilization
# and local image inventory (repo names, tag/digest stripped) to the
# controller. Building that inventory is one LocalImages() call to the
# container runtime per tick (see CONTAINER_RUNTIME below) — cheap on
# every supported backend.
REPORT_INTERVAL_S=15

# How often (seconds) PreheatMonitor samples currently-running containers
# against repos this worker has recently preheated, to answer "is preheat
# actually helping" (angryduck_worker_preheated_containers_running). This
# is a periodic sample for a dashboard question, not something a rollout
# needs to react to. Already cheap by default — the monitor skips its
# runtime call entirely on any node with nothing preheated recently, which
# in practice is most nodes in a fleet (only RANK_TOP_N nodes are ever
# preheat seeds at a time). On CONTAINER_RUNTIME=containerd specifically
# this is an N+1-subprocess pass; set to 0 to disable the monitor
# entirely.
PREHEAT_ATTRIBUTION_INTERVAL_S=300

# How long (seconds) after a successful preheat pull its repo still counts
# as "preheated" for the sample above.
PREHEAT_ATTRIBUTION_RETENTION_S=360

# Angry Duck itself never deletes images -- that used to be its own GC
# loop's job, but image lifecycle (disk-pressure avoidance, idle-image
# cleanup) is kubelet's own job and kubelet is the one actually wired into
# the eviction manager that decides DiskPressure, so a second, disconnected
# actor trying to do the same thing from outside adds risk without adding
# safety. See kubelet's own imageGCHighThresholdPercent/
# imageGCLowThresholdPercent (capacity-based, always available) and
# imageMaximumGCAge (time-based; Beta and on by default since Kubernetes
# 1.30) KubeletConfiguration fields.

# Which CLI to shell out to for image operations: crictl (default),
# containerd (ctr), or docker. None of them ship in the worker image: the
# worker runs the node's own binary (see HOST_ROOT below), found in
# /usr/local/sbin, /usr/local/bin, /usr/sbin, /usr/bin, /sbin, /bin — in
# that order, so a Kubespray install in /usr/local/bin wins over an apt one
# in /usr/bin, same as a shell. The worker exits at startup if the node
# doesn't have the binary this setting needs.
#
# crictl is the recommended default: it lists every running container's
# image in one `crictl ps -o json` call. The containerd backend has no
# equivalent bulk call — ListRunningImages()/RunningImageRepos() list
# container IDs, then shell out to `ctr containers info <id>` once PER
# container, on every call (PreheatMonitor's tick, or Puller's per-pull
# Spegel-presence check). On a node with 100+ containers that's 100+
# subprocess spawns, which is enough on its own to push a low-CPU-limit
# worker pod 2-3x over its own limit. Only use containerd if crictl
# genuinely isn't available on your nodes.
CONTAINER_RUNTIME=crictl

# The node's containerd socket, as a NODE path (it's resolved inside the
# node's root, not the container's). Passed to crictl as `-r` and to ctr as
# `-a` for peer transfers. No hostPath mount is needed for it.
CONTAINER_RUNTIME_ENDPOINT=unix:///run/containerd/containerd.sock

# Where the node's root filesystem is visible from inside the worker
# container. Every crictl/ctr/docker call is chrooted here, so it runs the
# node's binary with the node's libc and the node's /etc/crictl.yaml.
#
# /proc/1/root (default) is the node's real root, live mounts included,
# and needs no volume — only hostPID: true, CAP_SYS_CHROOT/CAP_SYS_PTRACE
# and an unconfined AppArmor profile, which the DaemonSet already sets.
# If a hardened node ever blocks it, mount hostPath "/" at /host with
# mountPropagation: HostToContainer and set HOST_ROOT=/host instead.
# Set to "/" for local runs outside Kubernetes (plain PATH lookup, no
# chroot).
HOST_ROOT=/proc/1/root

# Path to a dockerconfigjson file (the same format `docker login` writes
# and Kubernetes imagePullSecrets use: {"auths": {"host": {"auth": "..."}}})
# for authenticating preheat pulls against private registries. The worker
# pulls by shelling out directly to the container runtime CLI, which
# bypasses kubelet's CRI plumbing entirely — kubelet's own
# imagePullSecrets never apply to these pulls, regardless of what's
# configured on any Pod. Leave empty to pull anonymously (only works for
# public images). One file can hold credentials for multiple registries —
# no need for one secret per registry.
REGISTRY_CREDENTIALS_PATH=

# ---------------------------------------------------------------------------
# ImagePullBackOff rescue (controller + worker)
# ---------------------------------------------------------------------------
# When a pod is stuck in ImagePullBackOff/ErrImagePull and another node
# already has that exact image, the stuck node's worker copies the image
# from that peer over HTTP instead of from the registry. Only the blobs it
# is missing are sent, and containerd verifies every one on import.
#
# On by default, but it only switches on when both of these exist; without
# them it logs a warning and stays off:
#   - the shared token below (a Secret mounted in the controller and every
#     worker), because workers serve image content on the node network;
#   - (controller) a service account allowed to list pods.
RESCUE_ENABLED=true

# File holding the shared bearer token, at least 32 characters. The same
# Secret must be mounted in the controller and every worker. Rotating it
# needs a restart of both, since it's read once at startup.
RESCUE_TOKEN_PATH=/etc/angryduck/rescue-token/token

# Controller: how often to list Pending pods looking for stuck pulls.
RESCUE_INTERVAL_S=15

# Controller: after an attempt (or a decision not to try), wait this long
# before trying the same node+image again. Each failure in a row doubles
# the wait, up to RESCUE_BACKOFF_MAX_S; it resets once the pod is no longer
# stuck. After a successful rescue the pod still waits for kubelet's own
# backoff retry (up to 5 minutes).
RESCUE_RETRY_AFTER_S=120

# Controller: cap for the doubling above. A rescue that can never succeed
# then costs about one attempt per hour.
RESCUE_BACKOFF_MAX_S=3600

# Controller: how long to wait for one rescue to finish. The transfer
# itself keeps going on the worker even if the controller gives up.
RESCUE_TIMEOUT_S=600

# Controller: rescues in flight across the whole cluster.
RESCUE_MAX_CONCURRENT=2

# Controller: how many source nodes to offer per rescue, lowest disk
# utilization first. The worker tries them in order.
RESCUE_MAX_SOURCES=3

# Worker: images this node receives at the same time.
RESCUE_NODE_MAX_CONCURRENT=2

# Worker: when an attempt fails after some snapshots already arrived, they
# stay pinned against containerd's garbage collection this long, so the
# retry ships only what is still missing. Released right away on success.
RESCUE_PIN_TTL_S=3600

# Worker: node directory for the small list of those pins, so a restarted
# worker can still release them. A worker that finds temporary snapshots
# from an interrupted rescue at startup removes them.
RESCUE_STATE_DIR=/var/lib/angryduck

# Worker: containerd namespace holding kubelet's images.
RESCUE_CONTAINERD_NAMESPACE=k8s.io

# Worker: platform to import, as os/arch[/variant]. Defaults to linux/ plus
# the worker binary's own architecture, which matches the node.
# RESCUE_PLATFORM=linux/amd64

# ---------------------------------------------------------------------------
# Propagation (controller)
# ---------------------------------------------------------------------------
# After a preheat, spread the pushed image from the seeds to every eligible
# node, peer to peer (same transfer as rescue, so it also needs the rescue
# token). Only the RANK_TOP_N seeds pull from the registry. Each node that
# receives the image becomes a source for the next, so it spreads like a
# tree. Images nothing ends up running are later removed by kubelet's
# image GC (imageMaximumGCAge).
PROPAGATE_ENABLED=true

# How often active propagations are advanced.
PROPAGATE_INTERVAL_S=10

# How long after a push to keep spreading it (and retrying failed nodes).
PROPAGATE_WINDOW_S=3600

# Transfers in flight across the cluster, and per source node. Together
# they bound the network and disk I/O propagation can cause.
PROPAGATE_MAX_CONCURRENT=4
PROPAGATE_PER_SOURCE=2

# Skip nodes whose root filesystem is fuller than this (0-1), so propagation
# never pushes a node into kubelet's disk-pressure image GC. Keep it below
# kubelet's imageGCHighThresholdPercent.
PROPAGATE_MAX_UTILIZATION=0.70

# Nodes to leave out (substrings of the node name). Defaults to
# RANK_EXCLUDE_NODE_SUBSTRINGS. Rescue still covers them if a pod there
# needs the image.
# PROPAGATE_EXCLUDE_NODE_SUBSTRINGS=master,control-plane
