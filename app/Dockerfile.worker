FROM golang:1.27.0-alpine3.24 AS build
WORKDIR /src
COPY go.mod ./
COPY internal ./internal
COPY cmd/worker ./cmd/worker
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/angryduck-worker ./cmd/worker

# No crictl, ctr or docker in here. The worker runs the node's own copies,
# chrooted into the node's root filesystem (HOST_ROOT, default
# /proc/1/root — see internal/worker/hostexec.go), so:
#   - the node's version always runs: whatever apt or Kubespray installed,
#     static or dynamically linked (apt's ctr is dynamic — a copy in this
#     image could never have run it);
#   - apt keeps sole ownership of those files; nothing here pins, shadows
#     or replaces them, and an upgrade takes effect on the next exec;
#   - this image is one static binary on distroless/static.
FROM gcr.io/distroless/static-debian13
COPY --from=build /out/angryduck-worker /angryduck-worker
ENTRYPOINT ["/angryduck-worker"]
