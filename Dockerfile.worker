FROM golang:1.27.0-alpine3.24 AS build
WORKDIR /src
COPY go.mod ./
COPY internal ./internal
COPY cmd/worker ./cmd/worker
RUN CGO_ENABLED=0 go build -o /out/angryduck-worker ./cmd/worker

# The worker shells out to `ctr` by default (CONTAINER_RUNTIME=containerd).
# Rather than installing the full containerd daemon package (which drags in
# runc and its dependency tree just to get one CLI binary), pull only the
# `ctr` binary out of containerd's official *static* release tarball, which
# has no glibc dependency — letting the final image stay on distroless/static
# instead of needing a glibc-based distroless variant.
FROM alpine:3.24.1 AS ctr-fetch
ARG CONTAINERD_VERSION=2.3.4
ARG TARGETARCH=amd64
RUN apk add --no-cache curl && \
    curl -fsSL -o /tmp/containerd.tgz \
      "https://github.com/containerd/containerd/releases/download/v${CONTAINERD_VERSION}/containerd-static-${CONTAINERD_VERSION}-linux-${TARGETARCH}.tar.gz" && \
    tar -C /tmp -xzf /tmp/containerd.tgz bin/ctr

# ctr from the static tarball has no dynamic dependencies (verified: `ldd`
# reports "not a dynamic executable"), so distroless/static is sufficient —
# no libc needed. Swap CONTAINER_RUNTIME=crictl or =docker and this base
# image if your nodes use a different tool (those CLIs are glibc-dynamic,
# so you'd need distroless/base or distroless/cc instead).
FROM gcr.io/distroless/static-debian13
COPY --from=build /out/angryduck-worker /angryduck-worker
COPY --from=ctr-fetch /tmp/bin/ctr /usr/local/bin/ctr
ENTRYPOINT ["/angryduck-worker"]
